---
// src/pages/contacto.astro
// Reemplazar FORMSPREE_ID con el código real de formspree.io/f/XXXXXXXX
const FORMSPREE_ID = "mzeerlqo";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contacto — POXDRIVE</title>
  <meta name="description" content="Consultanos sobre sistemas de pisos y revestimientos industriales. Presupuestos sin cargo, asistencia técnica directa de fábrica." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --negro:    #1A1A1A;
      --naranja:  #E8500A;
      --concreto: #F0EDEA;
      --bg:       #111111;
      --surface:  #1C1C1C;
      --border:   rgba(255,255,255,0.08);
      --text:     #E8E4E0;
      --muted:    rgba(232,228,224,0.45);
    }

    body {
      font-family: 'Inter', Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* ---- NAV ---- */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(17,17,17,0.95);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
    }
    .nav-inner {
      max-width: 1100px; margin: 0 auto;
      padding: 1rem max(1.5rem, env(safe-area-inset-left,0px));
      display: flex; justify-content: space-between; align-items: center;
    }
    .nav-logo { font-size: 1.4rem; font-weight: 900; letter-spacing: 2px; text-decoration: none; color: #F0EDEA; }
    .nav-logo span { color: #E8500A; }
    .nav-links { display: flex; gap: 2rem; align-items: center; }
    .nav-links a { color: var(--text); text-decoration: none; font-size: 0.9rem; opacity: 0.75; transition: opacity 0.2s; }
    .nav-links a:hover, .nav-links a.active { opacity: 1; color: var(--naranja); }
    .nav-cta { background: var(--naranja); color: #fff !important; padding: 0.5rem 1.2rem; font-weight: 700; border-radius: 2px; opacity: 1 !important; }

    /* ---- HERO ---- */
    .hero {
      max-width: 1100px; margin: 0 auto;
      padding: 4rem max(1.5rem, env(safe-area-inset-left,0px)) 3rem;
      border-bottom: 1px solid var(--border);
    }
    .hero-label {
      font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase;
      color: var(--naranja); margin-bottom: 1rem;
    }
    .hero h1 {
      font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 700;
      color: var(--concreto); line-height: 1.15; margin-bottom: 1rem;
    }
    .hero p { color: var(--muted); font-size: 1rem; max-width: 520px; }

    /* ---- LAYOUT ---- */
    .page-grid {
      max-width: 1100px; margin: 0 auto;
      padding: 3rem max(1.5rem, env(safe-area-inset-left,0px)) 5rem;
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 4rem;
      align-items: start;
    }

    /* ---- FORMULARIO ---- */
    .form-section h2 {
      font-size: 1.1rem; font-weight: 700; color: var(--concreto);
      margin-bottom: 1.8rem;
    }

    .form-group { margin-bottom: 1.2rem; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.2rem; }

    label {
      display: block;
      font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px;
      text-transform: uppercase; color: var(--muted);
      margin-bottom: 0.45rem;
    }

    input, textarea, select {
      width: 100%;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 3px;
      color: var(--text);
      font-family: inherit;
      font-size: 0.9rem;
      padding: 0.75rem 1rem;
      transition: border-color 0.2s, box-shadow 0.2s;
      outline: none;
    }
    input::placeholder, textarea::placeholder { color: var(--muted); }
    input:focus, textarea:focus, select:focus {
      border-color: var(--naranja);
      box-shadow: 0 0 0 2px rgba(232,80,10,0.15);
    }
    select option { background: #1C1C1C; }
    textarea { min-height: 130px; resize: vertical; }

    .campo-requerido { color: var(--naranja); margin-left: 2px; }

    .btn-enviar {
      width: 100%; padding: 0.9rem 1.5rem;
      background: var(--naranja); color: #fff;
      font-family: inherit; font-size: 0.9rem; font-weight: 700;
      letter-spacing: 1px; text-transform: uppercase;
      border: none; border-radius: 3px; cursor: pointer;
      transition: background 0.2s;
      margin-top: 0.5rem;
    }
    .btn-enviar:hover { background: #c94008; }
    .btn-enviar:disabled { opacity: 0.5; cursor: not-allowed; }

    /* estados del formulario */
    .form-estado {
      display: none; margin-top: 1rem;
      padding: 1rem 1.2rem; border-radius: 3px;
      font-size: 0.85rem; line-height: 1.5;
    }
    .form-estado.exito {
      background: rgba(34,197,94,0.08);
      border: 1px solid rgba(34,197,94,0.3);
      color: #86efac;
    }
    .form-estado.error {
      background: rgba(239,68,68,0.08);
      border: 1px solid rgba(239,68,68,0.3);
      color: #fca5a5;
    }

    /* ---- SIDEBAR INFO ---- */
    .info-section { display: flex; flex-direction: column; gap: 0.6rem; }

    .info-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 1.4rem 1.5rem;
    }
    .info-card-label {
      font-size: 0.65rem; letter-spacing: 2.5px; text-transform: uppercase;
      color: var(--naranja); font-weight: 700; margin-bottom: 0.7rem;
    }
    .info-card h3 {
      font-size: 0.95rem; font-weight: 700; color: var(--concreto);
      margin-bottom: 0.4rem;
    }
    .info-card p { font-size: 0.82rem; color: var(--muted); line-height: 1.55; }
    .info-card a { color: var(--naranja); text-decoration: none; }
    .info-card a:hover { text-decoration: underline; }

    /* WhatsApp card */
    .wsp-btn {
      display: flex; align-items: center; gap: 0.75rem;
      margin-top: 1rem;
      background: #25D366; color: #fff;
      padding: 0.75rem 1.1rem; border-radius: 3px;
      text-decoration: none; font-size: 0.82rem; font-weight: 700;
      transition: background 0.2s;
    }
    .wsp-btn:hover { background: #1ebe5d; text-decoration: none !important; }
    .wsp-btn svg { flex-shrink: 0; }

    /* horario */
    .horario-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 0.45rem 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.8rem;
    }
    .horario-row:last-child { border-bottom: none; }
    .horario-dia { color: var(--muted); }
    .horario-hora { color: var(--text); font-weight: 600; }

    /* ---- FOOTER ---- */
    footer {
      border-top: 1px solid var(--border);
      padding: 2.5rem max(1.5rem, env(safe-area-inset-left,0px));
    }
    .footer-inner {
      max-width: 1100px; margin: 0 auto;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;
    }
    .footer-logo { font-size: 0.9rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); }
    .footer-logo span { color: var(--naranja); }
    .footer-copy { font-size: 0.75rem; color: var(--muted); }

    @media (max-width: 720px) {
      .page-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .form-row { grid-template-columns: 1fr; }
      .nav-links { display: none; }
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo">POX<span>DRIVE</span></a>
    <div class="nav-links">
      <a href="/industrias">Industrias</a>
      <a href="/casos">Casos de obra</a>
      <a href="/blog">Blog técnico</a>
      <a href="/descargas">Descargas</a>
      <a href="/contacto" class="active nav-cta">Contacto</a>
    </div>
  </div>
</nav>

<!-- HERO -->
<div class="hero">
  <p class="hero-label">Asistencia técnica directa de fábrica</p>
  <h1>¿En qué podemos<br/>ayudarte?</h1>
  <p>Consultanos sobre tu proyecto, pedí un presupuesto sin cargo o solicitá una visita técnica. Respondemos en menos de 24 h.</p>
</div>

<!-- CONTENIDO -->
<div class="page-grid">

  <!-- FORMULARIO -->
  <div class="form-section">
    <h2>Envianos tu consulta</h2>

    <form id="contact-form" action={`https://formspree.io/f/${FORMSPREE_ID}`} method="POST" novalidate>

      <div class="form-row">
        <div>
          <label for="nombre">Nombre <span class="campo-requerido">*</span></label>
          <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required />
        </div>
        <div>
          <label for="empresa">Empresa</label>
          <input type="text" id="empresa" name="empresa" placeholder="Nombre de la empresa" />
        </div>
      </div>

      <div class="form-row">
        <div>
          <label for="email">Email <span class="campo-requerido">*</span></label>
          <input type="email" id="email" name="email" placeholder="tu@email.com" required />
        </div>
        <div>
          <label for="telefono">Teléfono / WhatsApp</label>
          <input type="tel" id="telefono" name="telefono" placeholder="+54 9 11 ..." />
        </div>
      </div>

      <div class="form-group">
        <label for="tipo">Tipo de consulta</label>
        <select id="tipo" name="tipo">
          <option value="">— Seleccioná —</option>
          <option value="presupuesto">Solicitar presupuesto</option>
          <option value="asistencia-tecnica">Asistencia técnica</option>
          <option value="visita-obra">Visita técnica a obra</option>
          <option value="hoja-seguridad">Solicitar hoja de seguridad (SDS)</option>
          <option value="aplicador">Ser aplicador certificado</option>
          <option value="otro">Otro</option>
        </select>
      </div>

      <div class="form-group">
        <label for="industria">Industria / sector</label>
        <select id="industria" name="industria">
          <option value="">— Seleccioná —</option>
          <option value="alimenticia">Alimentaria</option>
          <option value="farmaceutica">Farmacéutica / cosmética</option>
          <option value="mineria">Minería / química</option>
          <option value="logistica">Logística / distribución</option>
          <option value="automotriz">Automotriz / metalúrgica</option>
          <option value="vial">Demarcación vial</option>
          <option value="comercial">Comercial / hogar</option>
          <option value="otro">Otro</option>
        </select>
      </div>

      <div class="form-group">
        <label for="mensaje">Mensaje <span class="campo-requerido">*</span></label>
        <textarea id="mensaje" name="mensaje" placeholder="Describí tu proyecto o consulta: tipo de piso, superficie aproximada, condiciones de uso..." required></textarea>
      </div>

      <!-- honeypot anti-spam -->
      <input type="text" name="_gotcha" style="display:none" />

      <button type="submit" class="btn-enviar" id="btn-submit">Enviar consulta</button>

      <div class="form-estado exito" id="estado-exito">
        ✓ ¡Mensaje enviado! Te respondemos en menos de 24 h a tu email.
      </div>
      <div class="form-estado error" id="estado-error">
        Hubo un error al enviar. Escribinos directamente a <a href="mailto:consultas@poxdrive.com.ar">consultas@poxdrive.com.ar</a>
      </div>
    </form>
  </div>

  <!-- SIDEBAR -->
  <div class="info-section">

    <div class="info-card">
      <p class="info-card-label">WhatsApp directo</p>
      <h3>Respuesta inmediata</h3>
      <p>Para consultas urgentes o seguimiento de presupuestos.</p>
      <a href="https://wa.me/5491138200513?text=Hola%20POXDRIVE%2C%20quiero%20consultar%20sobre%20pisos%20industriales" target="_blank" rel="noopener" class="wsp-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        +54 9 11 3820-0513
      </a>
    </div>

    <div class="info-card">
      <p class="info-card-label">Email</p>
      <h3>consultas@poxdrive.com.ar</h3>
      <p>Para presupuestos formales, solicitudes de hojas de seguridad y documentación técnica.</p>
    </div>

    <div class="info-card">
      <p class="info-card-label">Fábrica y laboratorio</p>
      <h3>Rincón 4672, La Tablada</h3>
      <p>La Matanza, Buenos Aires<br/>CP 1766</p>
    </div>

    <div class="info-card">
      <p class="info-card-label">Horario de atención</p>
      <div class="horario-row">
        <span class="horario-dia">Lunes a viernes</span>
        <span class="horario-hora">8:00 – 17:00</span>
      </div>
      <div class="horario-row">
        <span class="horario-dia">Sábados</span>
        <span class="horario-hora">8:00 – 12:00</span>
      </div>
      <div class="horario-row">
        <span class="horario-dia">Domingos</span>
        <span class="horario-hora">Cerrado</span>
      </div>
    </div>

  </div>
</div>

<!-- FOOTER -->
<footer>
  <div class="footer-inner">
    <div class="footer-logo">POX<span>DRIVE</span></div>
    <p class="footer-copy">FARBENPAINT S.R.L. · Rincón 4672, La Tablada, Bs. As. · consultas@poxdrive.com.ar</p>
  </div>
</footer>

<script define:vars={{ FORMSPREE_ID }}>
  const form = document.getElementById('contact-form');
  const btn  = document.getElementById('btn-submit');
  const ok   = document.getElementById('estado-exito');
  const err  = document.getElementById('estado-error');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }

    btn.disabled = true;
    btn.textContent = 'Enviando...';
    ok.style.display = 'none';
    err.style.display = 'none';

    try {
      const res = await fetch(`https://formspree.io/f/${FORMSPREE_ID}`, {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form),
      });
      if (res.ok) {
        ok.style.display = 'block';
        form.reset();
      } else {
        err.style.display = 'block';
      }
    } catch {
      err.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Enviar consulta';
    }
  });
</script>

</body>
</html>
