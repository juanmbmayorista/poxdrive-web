---
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>POXDRIVE — Pisos Industriales de Alta Performance</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: Calibri, Arial, sans-serif; background: #1A1A1A; color: #F0EDEA; }

      header {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 100;
        background: rgba(26,26,26,0.95);
        border-bottom: 1px solid #2a2a2a;
      }
      .nav-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .nav-logo { font-size: 1.4rem; font-weight: 900; letter-spacing: 2px; text-decoration: none; color: #F0EDEA; }
      .nav-logo span { color: #E8500A; }
      nav { display: flex; gap: 2rem; align-items: center; }
      nav a { color: #F0EDEA; text-decoration: none; font-size: 0.95rem; }
      nav a:hover { color: #E8500A; }
      .nav-cta { background: #E8500A; color: #fff !important; padding: 0.5rem 1.2rem; font-weight: 700; border-radius: 4px; }
      .nav-dropdown { position: relative; }
      .nav-dropdown > a { color: #F0EDEA; text-decoration: none; font-size: 0.95rem; }
      .nav-dropdown > a:hover { color: #E8500A; }
      .dropdown-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        background: #1a1a1a;
        border: 1px solid #2a2a2a;
        border-radius: 6px;
        min-width: 180px;
        padding: 8px 0;
        z-index: 200;
        margin-top: 8px;
      }
      .nav-dropdown:hover .dropdown-menu { display: block; }
      .dropdown-menu a {
        display: block;
        padding: 8px 16px;
        color: #9a9490;
        text-decoration: none;
        font-size: 0.875rem;
      }
      .dropdown-menu a:hover { color: #F0EDEA; background: #222; }
      .dropdown-menu a.active { color: #E8500A; }
      .nav-cta:hover { background: #c94008; }
      .hamburger { display: none; background: none; border: none; cursor: pointer; padding: 4px; }
      .hamburger span { display: block; width: 22px; height: 2px; background: #F0EDEA; margin: 5px 0; border-radius: 2px; }

      .hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 2rem;
        background: linear-gradient(160deg, #1A1A1A 60%, #2a1a10 100%);
      }
      .logo { font-size: 3.5rem; font-weight: 900; letter-spacing: 2px; }
      .logo span { color: #E8500A; }
      .tagline { font-size: 1.25rem; color: #9a9490; margin: 1rem 0 2.5rem; max-width: 500px; line-height: 1.6; }
      .cta-btn {
        background: #E8500A;
        color: #fff;
        border: none;
        padding: 1rem 2.5rem;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        letter-spacing: 1px;
      }
      .cta-btn:hover { background: #c94008; }

      .problemas { padding: 5rem 2rem; background: #111; }
      .problemas-inner { max-width: 1100px; margin: 0 auto; }
      .problemas h2 { font-size: 2rem; margin-bottom: 3rem; text-align: center; }
      .problemas-layout { display: flex; gap: 3rem; align-items: flex-start; }
      .problema-lista { list-style: none; min-width: 280px; }
      .problema-item {
        padding: 1rem 1.2rem;
        margin-bottom: 0.5rem;
        cursor: pointer;
        border-left: 3px solid transparent;
        color: #9a9490;
        transition: all 0.2s;
      }
      .problema-item:hover { color: #F0EDEA; border-left-color: #555; }
      .problema-item.active { color: #F0EDEA; border-left-color: #E8500A; background: #1a1a1a; }
      .solucion-panel { flex: 1; background: #1a1a1a; padding: 2.5rem; min-height: 220px; }
      .solucion.hidden { display: none; }
      .tag { font-size: 0.7rem; letter-spacing: 3px; color: #E8500A; margin-bottom: 0.8rem; }
      .solucion h3 { font-size: 1.5rem; margin-bottom: 1rem; }
      .solucion p { color: #9a9490; line-height: 1.7; margin-bottom: 1.5rem; }
      .sol-cta { color: #E8500A; text-decoration: none; font-weight: 700; font-size: 0.9rem; letter-spacing: 1px; }
      .sol-cta:hover { text-decoration: underline; }

      /* CONTACTO */
      .contacto { padding: 5rem 2rem; background: #1A1A1A; }
      .contacto-inner { max-width: 700px; margin: 0 auto; }
      .contacto h2 { font-size: 2rem; margin-bottom: 0.5rem; }
      .contacto-sub { color: #9a9490; margin-bottom: 2.5rem; line-height: 1.6; }
      .form-group { margin-bottom: 1.2rem; }
      .form-group label { display: block; font-size: 0.85rem; letter-spacing: 1px; color: #9a9490; margin-bottom: 0.4rem; }
      .form-group input,
      .form-group select,
      .form-group textarea {
        width: 100%;
        background: #111;
        border: 1px solid #2a2a2a;
        color: #F0EDEA;
        padding: 0.8rem 1rem;
        font-family: Calibri, Arial, sans-serif;
        font-size: 1rem;
        outline: none;
        transition: border-color 0.2s;
      }
      .form-group input:focus,
      .form-group select,
      .form-group textarea:focus { border-color: #E8500A; }
      .form-group select { cursor: pointer; }
      .form-group textarea { resize: vertical; min-height: 120px; }
      .form-row { display: flex; gap: 1rem; }
      .form-row .form-group { flex: 1; }
      .form-submit {
        background: #E8500A;
        color: #fff;
        border: none;
        padding: 1rem 2.5rem;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        letter-spacing: 1px;
        width: 100%;
        margin-top: 0.5rem;
        font-family: Calibri, Arial, sans-serif;
      }
      .form-submit:hover { background: #c94008; }
      .form-success { display: none; text-align: center; padding: 3rem 0; }
      .form-success .check { font-size: 3rem; color: #E8500A; margin-bottom: 1rem; }
      .form-success h3 { font-size: 1.4rem; margin-bottom: 0.5rem; }
      .form-success p { color: #9a9490; }

      /* FOOTER */
      footer {
        background: #111;
        border-top: 1px solid #2a2a2a;
        padding: 3rem 2rem;
      }
      .footer-inner {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 3rem;
        flex-wrap: wrap;
      }
      .footer-brand .footer-logo { font-size: 1.4rem; font-weight: 900; letter-spacing: 2px; margin-bottom: 0.5rem; }
      .footer-brand .footer-logo span { color: #E8500A; }
      .footer-brand p { color: #9a9490; font-size: 0.85rem; line-height: 1.6; max-width: 260px; }
      .footer-col h4 { font-size: 0.75rem; letter-spacing: 2px; color: #E8500A; margin-bottom: 1rem; }
      .footer-col ul { list-style: none; }
      .footer-col ul li { margin-bottom: 0.5rem; }
      .footer-col ul li a { color: #9a9490; text-decoration: none; font-size: 0.9rem; }
      .footer-col ul li a:hover { color: #F0EDEA; }
      .footer-col address { color: #9a9490; font-style: normal; font-size: 0.9rem; line-height: 1.7; }
      .footer-bottom {
        max-width: 1100px;
        margin: 2rem auto 0;
        padding-top: 1.5rem;
        border-top: 1px solid #2a2a2a;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .footer-bottom p { color: #555; font-size: 0.8rem; }

      @media(max-width: 768px) {
        nav .nav-links-group { display: none; }
        .hamburger { display: block; }
        .problemas-layout { flex-direction: column; }
        .form-row { flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="nav-inner">
        <a href="/" class="nav-logo">POX<span>DRIVE</span></a>
        <nav>
          <div class="nav-links-group" style="display:flex;gap:2rem;align-items:center;">
            <div class="nav-dropdown">
              <a href="/alimenticia">Industrias ▾</a>
              <div class="dropdown-menu">
                <a href="/alimenticia">Alimentaria</a>
                <a href="/farmaceutica">Farmacéutica</a>
                <a href="/mineria">Minería</a>
                <a href="/logistica">Logística</a>
              </div>
            </div>
            <a href="/blog">Blog</a>
            <a href="/casos">Casos de obra</a>
            <a href="/nosotros">Nosotros</a>
          </div>
          <a href="/contacto" class="nav-cta">Consultá</a>
          <button class="hamburger" aria-label="Menú"><span></span><span></span><span></span></button>
        </nav>
      </div>
    </header>

    <section class="hero">
      <div class="logo">POX<span>DRIVE</span></div>
      <p class="tagline">Pisos industriales de alta performance para alimentación, farmacia, minería y logística.</p>
      <a href="#contacto" class="cta-btn">CONSULTÁ TU PROYECTO</a>
    </section>

    <section class="problemas" id="problemas">
      <div class="problemas-inner">
        <h2>¿Cuál es tu problema?</h2>
        <div class="problemas-layout">
          <ul class="problema-lista">
            <li class="problema-item active" data-id="fisuras">Fisuras y deterioro del piso</li>
            <li class="problema-item" data-id="senasa">Necesito cumplir SENASA / BPM</li>
            <li class="problema-item" data-id="resbaladizo">Piso resbaladizo — riesgo de accidentes</li>
            <li class="problema-item" data-id="quimicos">Exposición a reactivos químicos</li>
            <li class="problema-item" data-id="autoelevadores">Tráfico intenso de autoelevadores</li>
          </ul>
          <div class="solucion-panel">
            <div class="solucion" data-id="fisuras">
              <div class="tag">SOLUCIÓN</div>
              <h3>Mortero epoxi M-2</h3>
              <p>Recubrimiento de alta resistencia mecánica que sella fisuras y reconstruye el sustrato. Apto para aplicación en frío y reanudación de actividad en 24 hs.</p>
              <a href="/contacto" class="sol-cta">Consultá este caso →</a>
            </div>
            <div class="solucion hidden" data-id="senasa">
              <div class="tag">SOLUCIÓN</div>
              <h3>Sistema CEM-AU</h3>
              <p>Recubrimiento cementicio-acrílico aprobado para plantas alimenticias y farmacéuticas. Cumple SENASA, BPM y normativa GMP. Sin juntas, sin porosidad.</p>
              <a href="/contacto" class="sol-cta">Consultá este caso →</a>
            </div>
            <div class="solucion hidden" data-id="resbaladizo">
              <div class="tag">SOLUCIÓN</div>
              <h3>Epoxi antideslizante AN-1 AD</h3>
              <p>Acabado texturado con partículas de corindón que garantiza coeficiente de fricción seguro en zonas húmedas, grasas o de alto tránsito peatonal.</p>
              <a href="/contacto" class="sol-cta">Consultá este caso →</a>
            </div>
            <div class="solucion hidden" data-id="quimicos">
              <div class="tag">SOLUCIÓN</div>
              <h3>Mortero antiácido</h3>
              <p>Sistema multicapa con resina novolaca de alta resistencia química. Soporta ácidos, álcalis y solventes en plantas químicas, petroquímicas y laboratorios.</p>
              <a href="/contacto" class="sol-cta">Consultá este caso →</a>
            </div>
            <div class="solucion hidden" data-id="autoelevadores">
              <div class="tag">SOLUCIÓN</div>
              <h3>Epoxi industrial AC-33</h3>
              <p>Alta resistencia a la abrasión y al impacto. Diseñado para soportar el tráfico continuo de autoelevadores, zorras y maquinaria pesada en depósitos y plantas logísticas.</p>
              <a href="/contacto" class="sol-cta">Consultá este caso →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="contacto" id="contacto">
      <div class="contacto-inner">
        <h2>Consultá tu proyecto</h2>
        <p class="contacto-sub">Contanos el problema y te respondemos en menos de 24 hs con una evaluación técnica sin cargo.</p>

        <div id="contacto-form">
          <div class="form-row">
            <div class="form-group">
              <label>NOMBRE</label>
              <input type="text" id="nombre" placeholder="Tu nombre" />
            </div>
            <div class="form-group">
              <label>EMPRESA</label>
              <input type="text" id="empresa" placeholder="Razón social o nombre" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>TELÉFONO / WHATSAPP</label>
              <input type="tel" id="telefono" placeholder="+54 11 ..." />
            </div>
            <div class="form-group">
              <label>EMAIL</label>
              <input type="email" id="email" placeholder="correo@empresa.com" />
            </div>
          </div>
          <div class="form-group">
            <label>SECTOR</label>
            <select id="sector">
              <option value="">Seleccioná tu industria...</option>
              <option>Alimentaria / Frigorífico</option>
              <option>Farmacéutica / Laboratorio</option>
              <option>Minería / Petroquímica</option>
              <option>Logística / Depósito</option>
              <option>Otro</option>
            </select>
          </div>
          <div class="form-group">
            <label>DESCRIPCIÓN DEL PROBLEMA</label>
            <textarea id="mensaje" placeholder="Contanos qué está pasando con el piso: tipo de daño, superficie aproximada, urgencia..."></textarea>
          </div>
          <button class="form-submit" id="btn-enviar">ENVIAR CONSULTA</button>
        </div>

        <div class="form-success" id="form-success">
          <div class="check">✓</div>
          <h3>¡Consulta recibida!</h3>
          <p>Te contactamos en menos de 24 hs con una evaluación técnica.</p>
        </div>
      </div>
    </section>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <div class="footer-logo">POX<span>DRIVE</span></div>
          <p>Sistemas de pisos industriales de alta performance. Fabricación propia en Argentina.</p>
        </div>
        <div class="footer-col">
          <h4>INDUSTRIAS</h4>
          <ul>
            <li><a href="/alimenticia">Alimentaria</a></li>
            <li><a href="/farmaceutica">Farmacéutica</a></li>
            <li><a href="/mineria">Minería</a></li>
            <li><a href="/logistica">Logística</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>CONTENIDO</h4>
          <ul>
            <li><a href="/blog">Blog técnico</a></li>
            <li><a href="/casos">Casos de obra</a></li>
            <li><a href="/nosotros">Nosotros</a></li>
            <li><a href="/aplicadores">Aplicadores</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>CONTACTO</h4>
          <address>
            FARBENPAINT S.R.L.<br />
            Rincón 4672, La Tablada<br />
            Buenos Aires, Argentina<br />
            <br />
            <a href="https://wa.me/5491138200513" style="color:#E8500A;">WhatsApp</a>
          </address>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2025 FARBENPAINT S.R.L. — Todos los derechos reservados.</p>
        <p>Fabricado en Argentina</p>
      </div>
    </footer>

    <script>
      const items = document.querySelectorAll('.problema-item');
      const soluciones = document.querySelectorAll('.solucion');
      items.forEach(item => {
        item.addEventListener('click', () => {
          items.forEach(i => i.classList.remove('active'));
          soluciones.forEach(s => s.classList.add('hidden'));
          item.classList.add('active');
          document.querySelector(`.solucion[data-id="${item.dataset.id}"]`).classList.remove('hidden');
        });
      });

      document.getElementById('btn-enviar').addEventListener('click', () => {
        const nombre = document.getElementById('nombre').value.trim();
        const email = document.getElementById('email').value.trim();
        if (!nombre || !email) {
          alert('Por favor completá al menos tu nombre y email.');
          return;
        }
        document.getElementById('contacto-form').style.display = 'none';
        document.getElementById('form-success').style.display = 'block';
      });
    </script>
  </body>
</html>
