    .nav-logo span{color:var(--naranja)}
    .nav-links{display:flex;gap:32px;list-style:none}
    .nav-links a{color:var(--muted);text-decoration:none;font-size:0.875rem;font-weight:500;transition:color 0.2s}
    .nav-links a:hover,.nav-links a.active{color:var(--text)}
    .nav-cta{background:var(--naranja);color:#fff;text-decoration:none;padding:8px 20px;border-radius:6px;font-size:0.875rem;font-weight:600}
    .hamburger{display:none;background:none;border:none;cursor:pointer;padding:4px}
    .hamburger span{display:block;width:22px;height:2px;background:var(--text);margin:5px 0;border-radius:2px}
    .article-wrap{max-width:1200px;margin:0 auto;padding:64px max(24px,env(safe-area-inset-left,0px)) 80px;display:grid;grid-template-columns:1fr 300px;gap:64px;align-items:start}
    .article-main{min-width:0}
    .breadcrumb{display:flex;gap:8px;align-items:center;font-size:0.8rem;color:var(--muted);margin-bottom:32px}
    .breadcrumb a{color:var(--muted);text-decoration:none}.breadcrumb a:hover{color:var(--text)}.breadcrumb span{color:var(--border)}
    .article-tags{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
    .tag{font-size:0.7rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;padding:4px 10px;border-radius:4px;background:rgba(232,80,10,0.12);color:var(--naranja)}
    .tag.yellow{background:rgba(234,179,8,0.12);color:#facc15}
    .article-main h1{font-size:clamp(1.75rem,3.5vw,2.5rem);font-weight:700;letter-spacing:-0.03em;line-height:1.2;margin-bottom:20px;text-wrap:balance}
    .article-meta{font-size:0.85rem;color:var(--muted);margin-bottom:40px;padding-bottom:32px;border-bottom:1px solid var(--border)}
    .article-main h2{font-size:1.35rem;font-weight:700;letter-spacing:-0.02em;margin-top:48px;margin-bottom:16px;color:var(--text)}
    .article-main h3{font-size:1.05rem;font-weight:700;margin-top:28px;margin-bottom:10px;color:var(--text)}
    .article-main p{color:var(--muted);margin-bottom:16px;line-height:1.75}
    .article-main p strong{color:var(--text);font-weight:600}
    .article-main ul{margin:0 0 16px 24px}
    .article-main li{color:var(--muted);margin-bottom:8px;line-height:1.65}
