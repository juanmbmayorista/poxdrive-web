---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Red de Aplicadores — POXDRIVE</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Calibri, Arial, sans-serif; background: #1A1A1A; color: #F0EDEA; }
    header { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(26,26,26,0.97); border-bottom: 1px solid #2a2a2a; }
    .nav-inner { max-width: 1100px; margin: 0 auto; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
    .nav-logo { font-size: 1.4rem; font-weight: 900; letter-spacing: 2px; text-decoration: none; color: #F0EDEA; }
    .nav-logo span { color: #E8500A; }
    nav { display: flex; gap: 2rem; align-items: center; }
    nav a { color: #F0EDEA; text-decoration: none; font-size: 0.9rem; opacity: 0.75; transition: opacity 0.2s; }
    nav a:hover, nav a.active { opacity: 1; color: #E8500A; }
    .nav-cta { background: #E8500A; color: #fff !important; padding: 0.5rem 1.2rem; font-weight: 700; border-radius: 2px; opacity: 1 !important; }

    .hero { background: #1A1A1A; padding: 9rem 2rem 5rem; text-align: center; }
    .hero-inner { max-width: 720px; margin: 0 auto; }
    .hero-eyebrow { font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; color: #E8500A; margin-bottom: 1.2rem; }
    .hero h1 { font-size: 2.8rem; line-height: 1.2; font-style: italic; font-family: Georgia, serif; margin-bottom: 1.5rem; }
    .hero-sub { font-size: 1.05rem; opacity: 0.7; line-height: 1.7; margin-bottom: 2.5rem; }
    .btn-orange { background: #E8500A; color: #fff; padding: 0.9rem 2rem; font-weight: 700; border-radius: 2px; text-decoration: none; font-size: 0.95rem; display: inline-block; }

    section { padding: 5rem 2rem; }
    .container { max-width: 1100px; margin: 0 auto; }
    .section-label { font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; color: #E8500A; margin-bottom: 0.8rem; }
    .section-title { font-size: 2rem; font-style: italic; font-family: Georgia, serif; margin-bottom: 0.8rem; }
    .section-sub { opacity: 0.6; font-size: 0.95rem; max-width: 580px; line-height: 1.6; margin-bottom: 2.5rem; }

    /* BENEFICIOS */
    .beneficios { display: flex; flex-direction: column; gap: 1rem; max-width: 820px; }
    .beneficio { display: grid; grid-template-columns: 64px 1fr; gap: 1.5rem; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 1.5rem 1.8rem; align-items: start; }
    .beneficio .num { font-size: 2rem; font-style: italic; font-family: Georgia, serif; color: #E8500A; line-height: 1; }
    .beneficio h4 { font-size: 1rem; font-weight: 700; margin-bottom: 0.4rem; }
    .beneficio p { font-size: 0.88rem; opacity: 0.65; line-height: 1.6; }
    .beneficio.futuro { border-style: dashed; border-color: rgba(232,80,10,0.35); background: rgba(232,80,10,0.04); }
    .beneficio.futuro .num { opacity: 0.5; }
    .tag-futuro { display: inline-block; font-size: 0.68rem; letter-spacing: 1px; text-transform: uppercase; background: rgba(232,80,10,0.2); color: #E8500A; padding: 2px 8px; border-radius: 2px; margin-left: 8px; vertical-align: middle; }

    /* TESTIMONIOS */
    .testimonios-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.2rem; }
    .testimonio-card { background: rgba(255,255,255,0.04); border: 1px dashed rgba(255,255,255,0.2); border-radius: 4px; padding: 1.8rem; }
    .testimonio-avatar { width: 48px; height: 48px; border-radius: 50%; background: rgba(255,255,255,0.1); margin-bottom: 1rem; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; opacity: 0.5; }
    .testimonio-card .quote { font-style: italic; font-family: Georgia, serif; opacity: 0.6; font-size: 0.9rem; line-height: 1.6; margin-bottom: 1rem; }
    .testimonio-card .nombre { font-size: 0.9rem; font-weight: 700; }
    .testimonio-card .zona { font-size: 0.75rem; color: #E8500A; text-transform: uppercase; letter-spacing: 1px; margin-top: 2px; }
    .nota-pendiente { font-size: 0.8rem; color: #E8500A; background: rgba(232,80,10,0.1); border: 1px solid rgba(232,80,10,0.25); border-radius: 4px; padding: 0.8rem 1rem; margin-bottom: 1.5rem; max-width: 820px; }

    /* REQUISITOS */
    .requisitos-wrap { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 2rem 2.5rem; max-width: 640px; }
    .req-item { display: flex; gap: 1rem; padding: 0.9rem 0; border-bottom: 1px solid rgba(255,255,255,0.07); font-size: 0.9rem; line-height: 1.5; }
    .req-item:last-child { border-bottom: none; }
    .req-item .check { color: #E8500A; font-weight: 700; flex-shrink: 0; }

    /* PROCESO */
    .proceso { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; }
    .paso { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 1.5rem; }
    .paso .n { font-size: 1.6rem; font-style: italic; font-family: Georgia, serif; color: #E8500A; margin-bottom: 0.6rem; }
    .paso h5 { font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; }
    .paso p { font-size: 0.8rem; opacity: 0.6; line-height: 1.5; }

    /* CTA FORM */
    .cta-section { background: #E8500A; }
    .cta-section .container { text-align: center; }
    .cta-section h2 { font-size: 2rem; font-style: italic; font-family: Georgia, serif; margin-bottom: 0.8rem; }
    .cta-section p { opacity: 0.9; margin-bottom: 2rem; max-width: 520px; margin-left: auto; margin-right: auto; }
    .form-row { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem; }
    .form-row input { padding: 0.8rem 1rem; border: none; border-radius: 2px; min-width: 200px; font-family: Calibri, Arial, sans-serif; font-size: 0.9rem; background: rgba(255,255,255,0.15); color: #fff; }
    .form-row input::placeholder { color: rgba(255,255,255,0.7); }
    .form-row input:focus { outline: 2px solid rgba(255,255,255,0.5); background: rgba(255,255,255,0.2); }
    .btn-white { background: #fff; color: #E8500A; padding: 0.8rem 1.8rem; font-weight: 700; border-radius: 2px; text-decoration: none; font-size: 0.9rem; border: none; cursor: pointer; font-family: Calibri, Arial, sans-serif; }
    .wa-alt { margin-top: 1.5rem; font-size: 0.85rem; opacity: 0.85; }
    .wa-alt a { color: #fff; font-weight: 700; }

    footer { background: #111; border-top: 1px solid #222; padding: 3rem 2rem; }
    .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 2rem; font-size: 0.85rem; opacity: 0.6; }

    @media (max-width: 768px) {
      .hero h1 { font-size: 2rem; }
      .beneficio { grid-template-columns: 1fr; gap: 0.5rem; }
      .beneficio .num { font-size: 1.5rem; }
      nav { display: none; }
    }
  </style>
</head>
<body>

<header>
  <div class="nav-inner">
    <a href="/" class="nav-logo">POX<span>DRIVE</span></a>
    <nav>
      <a href="/alimenticia">Alimentaria</a>
      <a href="/farmaceutica">Farmacéutica</a>
      <a href="/mineria">Minería</a>
      <a href="/logistica">Logística</a>
      <a href="/aplicadores" class="active">Aplicadores</a>
      <a href="/#contacto" class="nav-cta">Solicitar presupuesto</a>
    </nav>
  </div>
</header>

<div class="hero">
  <div class="hero-inner">
    <p class="hero-eyebrow">Red de Aplicadores Certificados</p>
    <h1>Hacé crecer tu negocio instalando sistemas POXDRIVE</h1>
    <p class="hero-sub">Sumate a la red de aplicadores certificados POXDRIVE y accedé a un segmento de obra que hoy no llega solo: plantas alimenticias, farmacéuticas, mineras y centros logísticos que exigen sistemas técnicos, no pintura. Te formamos, te respaldamos en cada obra y ponemos nuestra marca a trabajar para tu negocio.</p>
    <a href="#postularse" class="btn-orange">Quiero sumarme al programa</a>
  </div>
</div>

<section>
  <div class="container">
    <p class="section-label">Por qué certificarse</p>
    <h2 class="section-title">Lo que ganás trabajando con POXDRIVE</h2>
    <p class="section-sub">Ordenado por lo que más impacta en tu negocio como aplicador independiente.</p>
    <div class="beneficios">
      <div class="beneficio">
        <div class="num">01</div>
        <div>
          <h4>Acceso a un segmento de mayor valor</h4>
          <p>Las obras industriales — alimenticia, farmacéutica, minera, logística — pagan mejor y generan más recurrencia que el piso residencial o comercial genérico. Es un mercado al que un aplicador no especializado normalmente no entra solo.</p>
        </div>
      </div>
      <div class="beneficio">
        <div class="num">02</div>
        <div>
          <h4>Menos riesgo en obras técnicas</h4>
          <p>Respaldo técnico de POXDRIVE en obras complejas: visitas, especificación del sistema correcto y resolución de imprevistos en el momento. No quedás solo frente a un problema que no viste antes.</p>
        </div>
      </div>
      <div class="beneficio">
        <div class="num">03</div>
        <div>
          <h4>Credibilidad de marca prestada</h4>
          <p>El sello "Aplicador Certificado POXDRIVE" es un argumento de venta que usás con tus propios clientes finales para cerrar obras con más confianza y diferenciarte de la competencia genérica.</p>
        </div>
      </div>
      <div class="beneficio">
        <div class="num">04</div>
        <div>
          <h4>Capacitación técnica incluida</h4>
          <p>Formación en obra y en taller: aplicación de sistemas epoxi, poliuretánicos y cementicios. Protocolos de preparación de superficie, mezcla y control de calidad en cada trabajo.</p>
        </div>
      </div>
      <div class="beneficio futuro">
        <div class="num">05</div>
        <div>
          <h4>Derivación de clientes finales <span class="tag-futuro">Hacia dónde vamos</span></h4>
          <p>Esta web está pensada para captar consultas de empresas que buscan un aplicador certificado en su zona. A medida que ese flujo crezca, se derivará a la red de certificados. Es uno de los dos objetivos centrales de este sitio.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section style="background: rgba(255,255,255,0.02); border-top: 1px solid rgba(255,255,255,0.06); border-bottom: 1px solid rgba(255,255,255,0.06);">
  <div class="container">
    <p class="section-label">Empresas que ya trabajan con nosotros</p>
    <h2 class="section-title">Aplicadores de la red POXDRIVE</h2>
    <p class="section-sub">Empresas aplicadoras certificadas que ya trabajan con sistemas POXDRIVE en distintas zonas del país.</p>
    <div class="nota-pendiente">
      ⚠ Contenido a completar — reemplazar con 3 a 5 empresas reales: nombre, zona, cita del responsable.
    </div>
    <div class="testimonios-grid">
      <div class="testimonio-card">
        <div class="testimonio-avatar">LOGO</div>
        <div class="quote">"[Cita del responsable sobre la experiencia de trabajar con POXDRIVE en obras industriales]"</div>
        <div class="nombre">[Nombre de la empresa]</div>
        <div class="zona">[Zona / provincia]</div>
      </div>
      <div class="testimonio-card">
        <div class="testimonio-avatar">LOGO</div>
        <div class="quote">"[Cita del responsable sobre la experiencia de trabajar con POXDRIVE en obras industriales]"</div>
        <div class="nombre">[Nombre de la empresa]</div>
        <div class="zona">[Zona / provincia]</div>
      </div>
      <div class="testimonio-card">
        <div class="testimonio-avatar">LOGO</div>
        <div class="quote">"[Cita del responsable sobre la experiencia de trabajar con POXDRIVE en obras industriales]"</div>
        <div class="nombre">[Nombre de la empresa]</div>
        <div class="zona">[Zona / provincia]</div>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <p class="section-label">¿Quién puede postularse?</p>
    <h2 class="section-title">Requisitos para ser Aplicador Certificado POXDRIVE</h2>
    <p class="section-sub">Buscamos empresas con experiencia real en pisos industriales, no solo pintores. El programa está diseñado para quienes ya trabajan en el rubro y quieren dar el salto al segmento técnico.</p>
    <div class="requisitos-wrap">
      <div class="req-item"><span class="check">✔</span> Empresa o cuadrilla con experiencia comprobable en instalación de pisos industriales</div>
      <div class="req-item"><span class="check">✔</span> Herramientas y equipamiento propio para preparación de superficie y aplicación</div>
      <div class="req-item"><span class="check">✔</span> Disponibilidad para completar la capacitación inicial (teórica + práctica en obra supervisada)</div>
      <div class="req-item"><span class="check">✔</span> Referencias de obras anteriores o antigüedad mínima en el rubro de pisos industriales</div>
    </div>
  </div>
</section>

<section style="background: rgba(255,255,255,0.02); border-top: 1px solid rgba(255,255,255,0.06); border-bottom: 1px solid rgba(255,255,255,0.06);">
  <div class="container">
    <p class="section-label">Cómo funciona</p>
    <h2 class="section-title">Proceso de certificación</h2>
    <p class="section-sub">Cinco pasos, de la postulación al acompañamiento continuo en cada obra.</p>
    <div class="proceso">
      <div class="paso">
        <div class="n">1</div>
        <h5>Postulación</h5>
        <p>Formulario con tu experiencia, zona de trabajo y tipo de obras que hacés habitualmente.</p>
      </div>
      <div class="paso">
        <div class="n">2</div>
        <h5>Evaluación</h5>
        <p>Revisión de antecedentes y entrevista técnica breve para conocer tu perfil y capacidad instalada.</p>
      </div>
      <div class="paso">
        <div class="n">3</div>
        <h5>Capacitación</h5>
        <p>Módulo teórico + práctica supervisada en obra real con sistemas POXDRIVE.</p>
      </div>
      <div class="paso">
        <div class="n">4</div>
        <h5>Certificación</h5>
        <p>Alta como Aplicador Certificado POXDRIVE con acceso a materiales, protocolos y soporte técnico.</p>
      </div>
      <div class="paso">
        <div class="n">5</div>
        <h5>Seguimiento</h5>
        <p>Acompañamiento técnico continuo en las obras posteriores que realices con sistemas POXDRIVE.</p>
      </div>
    </div>
  </div>
</section>

<section class="cta-section" id="postularse">
  <div class="container">
    <h2>¿Sos una empresa aplicadora de pisos industriales?</h2>
    <p>Certificate con POXDRIVE y empezá a acceder a obras que hoy no llegan a tu negocio. Mandanos tus datos y te contactamos.</p>
    <form onsubmit="event.preventDefault(); this.innerHTML='<p style=\'color:#fff;font-size:1.1rem;margin-top:1rem;\'>✓ Recibimos tu postulación. Te contactamos a la brevedad.</p>'">
      <div class="form-row">
        <input type="text" placeholder="Nombre de tu empresa" required />
        <input type="text" placeholder="Zona de trabajo" required />
        <input type="tel" placeholder="WhatsApp de contacto" required />
        <button type="submit" class="btn-white">Quiero sumarme</button>
      </div>
    </form>
    <p class="wa-alt">O escribinos directamente: <a href="https://wa.me/5491138200513">WhatsApp +54 9 11 3820-0513</a></p>
  </div>
</section>

<footer>
  <div class="footer-inner">
    <div><strong>POXDRIVE</strong><br>FARBENTEC S.R.L.</div>
    <div>Rincón 4672 (1766)<br>La Tablada, Buenos Aires</div>
    <div>WhatsApp +54 9 11 3820-0513<br>Lunes a viernes 8 a 15 h</div>
    <div>
      <a href="/alimenticia" style="color:#F0EDEA; text-decoration:none;">Alimentaria</a> ·
      <a href="/farmaceutica" style="color:#F0EDEA; text-decoration:none;">Farmacéutica</a> ·
      <a href="/mineria" style="color:#F0EDEA; text-decoration:none;">Minería</a> ·
      <a href="/logistica" style="color:#F0EDEA; text-decoration:none;">Logística</a>
    </div>
  </div>
</footer>

</body>
</html>

