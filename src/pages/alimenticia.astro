<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Pisos para Industria Alimentaria — POXDRIVE</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Calibri, Arial, sans-serif; background: #1A1A1A; color: #F0EDEA; }
    header { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(26,26,26,0.97); border-bottom: 1px solid #2a2a2a; }
    .nav-inner { max-width: 1100px; margin: 0 auto; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
    .nav-logo { font-size: 1.4rem; font-weight: 900; letter-spacing: 2px; text-decoration: none; color: #F0EDEA; }
    .nav-logo span { color: #E8500A; }
    nav { display: flex; gap: 2rem; align-items: center; }
    nav a { color: #F0EDEA; text-decoration: none; font-size: 0.9rem; opacity: 0.75; transition: opacity 0.2s; }
    nav a:hover, nav a.active { opacity: 1; color: #E8500A; }
    .nav-cta { background: #E8500A; color: #fff !important; padding: 0.5rem 1.2rem; font-weight: 700; border-radius: 2px; opacity: 1 !important; }

    /* HERO */
    .hero { padding: 7rem 2rem 0; max-width: 1100px; margin: 0 auto; }
    .breadcrumb { font-size: 0.8rem; opacity: 0.5; margin-bottom: 2rem; letter-spacing: 1px; text-transform: uppercase; }
    .breadcrumb span { color: #E8500A; }
    .hero-eyebrow { font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; color: #E8500A; margin-bottom: 1rem; }
    .hero h1 { font-size: 3rem; line-height: 1.15; font-style: italic; font-family: Georgia, serif; margin-bottom: 1.5rem; max-width: 720px; }
    .hero-sub { font-size: 1.05rem; opacity: 0.65; line-height: 1.7; margin-bottom: 2rem; max-width: 620px; }
    .hero-badges { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 3rem; }
    .badge { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); padding: 0.45rem 1rem; font-size: 0.82rem; border-radius: 2px; }
    .badge::before { content: "✓ "; color: #E8500A; }
    .hero-divider { border: none; border-top: 1px solid rgba(255,255,255,0.08); margin-bottom: 5rem; }

    /* SECCIONES */
    section { padding: 5rem 2rem; }
    .container { max-width: 1100px; margin: 0 auto; }
    .section-label { font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; color: #E8500A; margin-bottom: 0.8rem; }
    .section-title { font-size: 2rem; font-style: italic; font-family: Georgia, serif; margin-bottom: 0.8rem; }
    .section-sub { opacity: 0.6; font-size: 0.95rem; max-width: 580px; line-height: 1.7; margin-bottom: 2.5rem; }

    /* REQUISITOS GRID */
    .req-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem; }
    .req-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 1.8rem 1.5rem; }
    .req-card .icon { font-size: 1.4rem; margin-bottom: 0.8rem; }
    .req-card h4 { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.5rem; }
    .req-card p { font-size: 0.85rem; opacity: 0.6; line-height: 1.6; }

    /* FICHA TÉCNICA */
    .ficha-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }
    .ficha-header { margin-bottom: 1.5rem; }
    .ficha-nombre { font-size: 1.3rem; font-weight: 700; margin-bottom: 0.3rem; }
    .ficha-desc { font-size: 0.9rem; opacity: 0.6; line-height: 1.6; }
    .ficha-tabla { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    .ficha-tabla tr { border-bottom: 1px solid rgba(255,255,255,0.07); }
    .ficha-tabla td { padding: 0.6rem 0; }
    .ficha-tabla td:first-child { opacity: 0.5; width: 45%; }
    .ficha-tabla td:last-child { font-weight: 600; }
    .ficha-certifs { margin-top: 1.2rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .certif-tag { background: rgba(232,80,10,0.15); border: 1px solid rgba(232,80,10,0.3); color: #E8500A; font-size: 0.75rem; padding: 0.3rem 0.7rem; border-radius: 2px; }
    .ficha-nota { background: rgba(255,255,255,0.04); border-left: 3px solid #E8500A; padding: 1rem 1.2rem; font-size: 0.85rem; opacity: 0.7; line-height: 1.6; margin-top: 1.5rem; }

    /* SISTEMAS */
    .sistemas-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; }
    .sistema-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 1.5rem; }
    .sistema-zona { font-size: 0.7rem; letter-spacing: 2px; text-transform: uppercase; color: #E8500A; margin-bottom: 0.4rem; }
    .sistema-nombre { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.3rem; }
    .sistema-desc { font-size: 0.84rem; opacity: 0.6; line-height: 1.55; }
    .sistema-spec { font-size: 0.78rem; opacity: 0.4; margin-top: 0.5rem; }

    /* CASO */
    .caso-wrap { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 2.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: center; }
    .caso-label { font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; color: #E8500A; margin-bottom: 0.8rem; }
    .caso-titulo { font-size: 1.4rem; font-style: italic; font-family: Georgia, serif; margin-bottom: 1rem; }
    .caso-texto { font-size: 0.9rem; opacity: 0.65; line-height: 1.7; }
    .caso-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .stat { }
    .stat .val { font-size: 1.8rem; font-style: italic; font-family: Georgia, serif; color: #E8500A; line-height: 1; }
    .stat .lbl { font-size: 0.78rem; opacity: 0.5; margin-top: 0.3rem; }

    /* CTA */
    .cta-section { background: #E8500A; }
    .cta-section h2 { font-size: 1.8rem; font-style: italic; font-family: Georgia, serif; margin-bottom: 0.8rem; }
    .cta-section p { opacity: 0.92; margin-bottom: 2rem; line-height: 1.6; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 0.8rem; align-items: end; }
    .form-row input, .form-row select { padding: 0.8rem 1rem; border: none; border-radius: 2px; font-family: Calibri, Arial, sans-serif; font-size: 0.9rem; background: rgba(255,255,255,0.2); color: #fff; width: 100%; }
    .form-row input::placeholder { color: rgba(255,255,255,0.7); }
    .btn-white { background: #fff; color: #E8500A; padding: 0.8rem 1.8rem; font-weight: 700; border-radius: 2px; font-size: 0.9rem; border: none; cursor: pointer; font-family: Calibri, Arial, sans-serif; white-space: nowrap; }
    .cta-alt { margin-top: 1.2rem; font-size: 0.85rem; opacity: 0.85; }
    .cta-alt a { color: #fff; font-weight: 700; }
    .success-msg { background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.4); border-radius: 4px; padding: 1.5rem; text-align: center; display: none; }

    footer { background: #111; border-top: 1px solid #222; padding: 3rem 2rem; }
    .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 2rem; font-size: 0.85rem; opacity: 0.6; }

    @media (max-width: 768px) {
      .hero h1 { font-size: 2rem; }
      .ficha-wrap { grid-template-columns: 1fr; }
      .caso-wrap { grid-template-columns: 1fr; }
      .form-row { grid-template-columns: 1fr; }
      nav { display: none; }
    }

    /* RECURSOS */
    .recursos-section { border-top: 1px solid rgba(255,255,255,0.06); }
    .recursos-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 2rem; }
    .recurso-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 1.4rem 1.5rem; text-decoration: none; color: #F0EDEA; display: block; transition: border-color 0.2s, background 0.2s; }
    .recurso-card:hover { border-color: #E8500A; background: rgba(232,80,10,0.07); }
    .recurso-tipo { font-size: 0.68rem; letter-spacing: 2px; text-transform: uppercase; color: #E8500A; margin-bottom: 0.5rem; }
    .recurso-nombre { font-size: 0.92rem; font-weight: 700; line-height: 1.3; margin-bottom: 0.3rem; }
    .recurso-meta { font-size: 0.78rem; opacity: 0.45; }

  /* ── Industrias dropdown ── */
  .nav-dropdown { position: relative; display: inline-block; }
  .nav-dropdown-btn {
    background: none; border: none; cursor: pointer;
    color: #F0EDEA; font-size: 0.95rem; font-family: inherit;
    padding: 0; display: flex; align-items: center; gap: 4px;
  }
  .nav-dropdown-btn:hover { color: #E8500A; }
  .dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    background: #1C1C1C;
    border: 1px solid #333;
    border-radius: 6px;
    min-width: 170px;
    padding: 6px 0;
    z-index: 999;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }
  .dropdown-menu.open { display: block; }
  .dropdown-menu a {
    display: block;
    padding: 9px 16px;
    color: #9a9490 !important;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 400;
  }
  .dropdown-menu a:hover { color: #F0EDEA !important; background: #252525; }

  </style>
</head>
<body>

<header>
  <div class="nav-inner">
    <a href="/" class="nav-logo">POX<span>DRIVE</span></a>
    <nav>
      <div class="nav-dropdown">
        <button class="nav-dropdown-btn" id="dd-btn">Industrias <span style="font-size:0.65em">▼</span></button>
        <div class="dropdown-menu" id="dd-menu">
