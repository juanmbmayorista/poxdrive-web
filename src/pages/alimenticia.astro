        <div class="stat"><div class="val">10</div><div class="lbl">días de obra con planta operativa</div></div>
        <div class="stat"><div class="val">1ª</div><div class="lbl">inspección SENASA aprobada</div></div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-section">
  <div class="container" style="max-width: 820px;">
    <h2>¿Su planta necesita cumplir SENASA?</h2>
