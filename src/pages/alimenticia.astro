    </div>
    <p class="cta-alt">O escribinos directo: <a href="https://wa.me/5491138200513">WhatsApp +54 9 11 3820-0513</a></p>
  </div>
</section>

<!-- RECURSOS TÉCNICOS -->
<section class="recursos-section">
  <div class="container">
    <p class="section-label">Recursos técnicos</p>
    <h2 class="section-title">Documentación para industria alimentaria</h2>
    <div class="recursos-grid">
      <a href="/esquemas/POXDRIVE_Esquemas_Alimenticia.html" class="recurso-card">
        <p class="recurso-tipo">Esquema de solución</p>
        <p class="recurso-nombre">Sistemas por zona — Industria Alimentaria</p>
        <p class="recurso-meta">8 zonas · especificaciones técnicas</p>
      </a>
