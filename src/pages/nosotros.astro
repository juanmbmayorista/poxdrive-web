---
// src/pages/nosotros.astro
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nosotros — POXDRIVE</title>
  <meta name="description" content="Más de 20 años desarrollando y fabricando sistemas de pisos y revestimientos industriales de alto desempeño. Conocé la historia de POXDRIVE." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --negro:    #1A1A1A;
      --naranja:  #E8500A;
      --concreto: #F0EDEA;
      --bg:       #111111;
      --surface:  #1C1C1C;
      --border:   rgba(255,255,255,0.08);
      --text:     #E8E4E0;
      --muted:    rgba(232,228,224,0.45);
    }

    body {
      font-family: 'Inter', Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }

    /* NAV */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(17,17,17,0.95);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
    }
    .nav-inner {
      max-width: 1100px; margin: 0 auto;
      padding: 1rem max(1.5rem, env(safe-area-inset-left,0px));
      display: flex; justify-content: space-between; align-items: center;
    }
    .nav-logo { font-size: 1.4rem; font-weight: 900; letter-spacing: 2px; text-decoration: none; color: #F0EDEA; }
    .nav-logo span { color: #E8500A; }
        .nav-links-group { display: flex; gap: 32px; align-items: center; }
    .nav-links-group a { color: var(--muted, rgba(232,228,224,0.45)); text-decoration: none; font-size: 0.875rem; font-weight: 500; }
    .nav-links-group a:hover, .nav-links-group a.active { color: #F0EDEA; }
    .nav-dropdown { position: relative; display: inline-block; }
    .nav-dropdown-btn { background: none; border: none; cursor: pointer; color: rgba(232,228,224,0.7); font-size: 0.875rem; font-family: inherit; padding: 0; display: flex; align-items: center; gap: 4px; font-weight: 500; }
    .nav-dropdown-btn:hover { color: #F0EDEA; }
    .dropdown-menu { display: none; position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%); background: #1C1C1C; border: 1px solid #333; border-radius: 6px; min-width: 170px; padding: 6px 0; z-index: 999; box-shadow: 0 8px 24px rgba(0,0,0,0.4); }
    .dropdown-menu.open { display: block; }
    .dropdown-menu a { display: block; padding: 9px 16px; color: #9a9490 !important; text-decoration: none; font-size: 0.875rem; font-weight: 400; opacity: 1 !important; }
    .dropdown-menu a:hover { color: #F0EDEA !important; background: #252525; }
    .nav-cta { background: var(--naranja); color: #fff !important; padding: 0.5rem 1.2rem; font-weight: 700; border-radius: 6px; text-decoration: none; }
    .hamburger { display: none; background: none; border: none; cursor: pointer; padding: 4px; }
    .hamburger span { display: block; width: 22px; height: 2px; background: #F0EDEA; margin: 5px 0; border-radius: 2px; }
    @media(max-width:768px) { .nav-links-group, .nav-cta { display: none; } .hamburger { display: block; } }

    /* HERO */
    .hero {
      max-width: 1100px; margin: 0 auto;
      padding: 5rem max(1.5rem, env(safe-area-inset-left,0px)) 4rem;
      border-bottom: 1px solid var(--border);
    }
    .hero-label {
      font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase;
      color: var(--naranja); margin-bottom: 1rem;
    }
    .hero h1 {
      font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 900;
      color: var(--concreto); line-height: 1.1;
      margin-bottom: 1.5rem; max-width: 700px;
    }
    .hero-bajada {
      font-size: 1.05rem; color: var(--muted);
      max-width: 560px; line-height: 1.7;
    }

    /* MÉTRICAS */
    .metricas {
      max-width: 1100px; margin: 0 auto;
      padding: 3.5rem max(1.5rem, env(safe-area-inset-left,0px));
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
      background: var(--border);
      border-bottom: 1px solid var(--border);
    }
    .metrica {
      background: var(--bg);
      padding: 2rem 2.5rem;
      display: flex; flex-direction: column; gap: 0.4rem;
    }
    .metrica-numero {
      font-size: clamp(2.4rem, 4vw, 3.2rem); font-weight: 900;
      color: var(--naranja); line-height: 1;
    }
    .metrica-label {
      font-size: 0.78rem; color: var(--muted); letter-spacing: 0.5px;
      text-transform: uppercase; font-weight: 600;
    }

    /* SECCIONES */
    .seccion {
      max-width: 1100px; margin: 0 auto;
      padding: 5rem max(1.5rem, env(safe-area-inset-left,0px));
      border-bottom: 1px solid var(--border);
    }
    .seccion:last-of-type { border-bottom: none; }

    .seccion-label {
      font-size: 0.65rem; letter-spacing: 3px; text-transform: uppercase;
      color: var(--naranja); font-weight: 700; margin-bottom: 1rem;
    }
    .seccion h2 {
      font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 700;
      color: var(--concreto); margin-bottom: 1.8rem; line-height: 1.2;
    }
    .seccion p {
      color: var(--muted); font-size: 0.95rem; max-width: 680px;
      margin-bottom: 1.2rem;
    }
    .seccion p:last-child { margin-bottom: 0; }

    /* Layout dos columnas */
    .dos-col {
      display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start;
    }
    .dos-col .seccion-texto { }
    .dos-col .seccion-aside { }

    /* Línea de tiempo */
    .timeline { display: flex; flex-direction: column; gap: 0; }
    .timeline-item {
      display: flex; gap: 1.5rem;
      padding-bottom: 2rem;
      position: relative;
    }
    .timeline-item:last-child { padding-bottom: 0; }
    .timeline-item:last-child .tl-linea::after { display: none; }

    .tl-left { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
    .tl-punto {
      width: 10px; height: 10px; border-radius: 50%;
      background: var(--naranja); flex-shrink: 0; margin-top: 5px;
    }
    .tl-linea {
      width: 1px; background: var(--border);
      flex: 1; min-height: 24px;
      margin-top: 6px;
    }

    .tl-anio {
      font-size: 0.65rem; letter-spacing: 2px; font-weight: 700;
      text-transform: uppercase; color: var(--naranja);
      margin-bottom: 0.3rem;
    }
    .tl-titulo {
      font-size: 0.9rem; font-weight: 700; color: var(--concreto);
      margin-bottom: 0.4rem;
    }
    .tl-texto { font-size: 0.82rem; color: var(--muted); line-height: 1.6; }

    /* Card planta */
    .planta-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px; padding: 2rem;
    }
    .planta-card-label {
      font-size: 0.65rem; letter-spacing: 2.5px; text-transform: uppercase;
      color: var(--naranja); font-weight: 700; margin-bottom: 1rem;
    }
    .planta-dato {
      display: flex; justify-content: space-between; align-items: flex-start;
      padding: 0.8rem 0; border-bottom: 1px solid var(--border);
      gap: 1rem;
    }
    .planta-dato:last-child { border-bottom: none; padding-bottom: 0; }
    .planta-dato-key { font-size: 0.78rem; color: var(--muted); flex-shrink: 0; }
    .planta-dato-val { font-size: 0.82rem; color: var(--text); font-weight: 600; text-align: right; }

    /* Valores */
    .valores-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
      margin-top: 0.5rem;
    }
    .valor-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px; padding: 1.5rem;
    }
    .valor-icono { font-size: 1.4rem; margin-bottom: 0.6rem; }
    .valor-titulo {
      font-size: 0.82rem; font-weight: 700; color: var(--concreto);
      margin-bottom: 0.4rem;
    }
    .valor-texto { font-size: 0.78rem; color: var(--muted); line-height: 1.55; }

    /* CTA final */
    .cta-banda {
      background: var(--surface);
      border-top: 1px solid var(--border);
    }
    .cta-inner {
      max-width: 1100px; margin: 0 auto;
      padding: 4rem max(1.5rem, env(safe-area-inset-left,0px));
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 2rem;
    }
    .cta-texto h3 { font-size: 1.3rem; font-weight: 700; color: var(--concreto); margin-bottom: 0.4rem; }
    .cta-texto p { font-size: 0.88rem; color: var(--muted); }
    .cta-btn {
      background: var(--naranja); color: #fff;
      padding: 0.9rem 2rem; border-radius: 2px;
      font-weight: 700; font-size: 0.85rem; letter-spacing: 0.5px;
      text-decoration: none; white-space: nowrap;
      transition: background 0.2s;
    }
    .cta-btn:hover { background: #c94008; }

    /* FOOTER */
    footer {
      border-top: 1px solid var(--border);
      padding: 2.5rem max(1.5rem, env(safe-area-inset-left,0px));
    }
    .footer-inner {
      max-width: 1100px; margin: 0 auto;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;
    }
    .footer-logo { font-size: 0.9rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); }
    .footer-logo span { color: var(--naranja); }
    .footer-copy { font-size: 0.75rem; color: var(--muted); }

    @media (max-width: 720px) {
      .metricas { grid-template-columns: 1fr; }
      .dos-col { grid-template-columns: 1fr; gap: 3rem; }
      .valores-grid { grid-template-columns: 1fr; }
      .nav-links-group, .nav-cta { display: none; }
      .cta-inner { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo">POX<span>DRIVE</span></a>
    <div class="nav-links-group">
      <div class="nav-dropdown">
        <button class="nav-dropdown-btn" id="dd-btn">Industrias <span style="font-size:0.65em">▼</span></button>
        <div class="dropdown-menu" id="dd-menu">
          <a href="/alimenticia">Alimentaria</a>
          <a href="/farmaceutica">Farmacéutica</a>
          <a href="/mineria">Minería</a>
          <a href="/logistica">Logística</a>
        </div>
      </div>
      <a href="/blog">Blog</a>
      <a href="/casos">Casos de obra</a>
      <a href="/nosotros">Nosotros</a>
    </div>
    <a href="/contacto" class="nav-cta">Consultá</a>
    <button class="hamburger" aria-label="Menú"><span></span><span></span><span></span></button>
  </div>
</nav>

<!-- HERO -->
<div class="hero">
  <p class="hero-label">Fábrica argentina de recubrimientos industriales</p>
  <h1>Más de 20 años construyendo pisos que trabajan tan duro como vos</h1>
  <p class="hero-bajada">
    POXDRIVE es una empresa argentina de desarrollo y fabricación de sistemas de pisos y revestimientos industriales de alto desempeño. Desde nuestro laboratorio en La Tablada formulamos soluciones epoxi, poliuretano y cementicias para las industrias más exigentes del país.
  </p>
</div>

<!-- MÉTRICAS -->
<div class="metricas">
  <div class="metrica">
    <span class="metrica-numero">+20</span>
    <span class="metrica-label">Años en el mercado</span>
  </div>
  <div class="metrica">
    <span class="metrica-numero">23</span>
    <span class="metrica-label">Provincias donde operamos</span>
  </div>
  <div class="metrica">
    <span class="metrica-numero">100%</span>
    <span class="metrica-label">Desarrollo y fabricación propios</span>
  </div>
</div>

<!-- ORIGEN -->
<div class="seccion">
  <div class="dos-col">
    <div class="seccion-texto">
      <p class="seccion-label">Nuestro origen</p>
      <h2>Una solución que no existía en el mercado</h2>
      <p>
        La historia de POXDRIVE comienza en 2004 con un desafío técnico concreto: un fabricante de filtros industriales necesitaba un adhesivo capaz de resistir simultáneamente las demandas químicas y térmicas de un proceso a 100 °C. Había probado todas las opciones disponibles en el mercado, sin éxito.
      </p>
      <p>
        Visitamos su planta, analizamos las condiciones reales de aplicación y desarrollamos tres variantes de un sistema epoxi bicomponente de curado en caliente, pertenecientes a nuestra línea MASTERPOX. Dos de ellas resolvieron el problema de manera definitiva. Ese primer desarrollo marcó el ADN de la empresa: escuchar al cliente, entender su proceso y formular desde cero cuando el mercado no tiene respuesta.
      </p>
      <p>
        En 2009, Juan Manuel Blanco —bioquímico con especialización en recubrimientos— se incorporó como socio gerente y director de desarrollo de productos, imprimiendo un perfil técnico-científico que distingue a POXDRIVE hasta el día de hoy.
      </p>
    </div>
    <div class="seccion-aside">
      <div class="timeline">
        <div class="timeline-item">
          <div class="tl-left"><div class="tl-punto"></div><div class="tl-linea"></div></div>
          <div>
            <p class="tl-anio">2004</p>
            <p class="tl-titulo">Fundación</p>
            <p class="tl-texto">Nace POXDRIVE con el desarrollo del primer sistema epoxi bicomponente de curado en caliente para filtros industriales.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="tl-left"><div class="tl-punto"></div><div class="tl-linea"></div></div>
          <div>
            <p class="tl-anio">2009</p>
            <p class="tl-titulo">Nueva conducción técnica</p>
            <p class="tl-texto">Incorporación de Juan Manuel Blanco como socio gerente y director de I+D. Ampliación del portafolio hacia sistemas de pisos industriales.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="tl-left"><div class="tl-punto"></div><div class="tl-linea"></div></div>
          <div>
            <p class="tl-anio">2009–2021</p>
            <p class="tl-titulo">Expansión nacional</p>
            <p class="tl-texto">Desarrollo de red de aplicadores certificados en múltiples provincias. Incorporación a las principales industrias alimenticias, farmacéuticas y químicas del país.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="tl-left"><div class="tl-punto"></div><div class="tl-linea"></div></div>
          <div>
            <p class="tl-anio">2022</p>
            <p class="tl-titulo">Nueva planta en La Tablada</p>
            <p class="tl-texto">Relocalización y ampliación de la planta productiva. Duplicación de la capacidad de fabricación y mayor superficie para depósito de materias primas y producto terminado.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- PLANTA -->
<div class="seccion">
  <div class="dos-col">
    <div class="seccion-aside">
      <div class="planta-card">
        <p class="planta-card-label">Planta productiva</p>
        <div class="planta-dato">
          <span class="planta-dato-key">Ubicación</span>
          <span class="planta-dato-val">Rincón 4672, La Tablada<br/>La Matanza, Buenos Aires</span>
        </div>
        <div class="planta-dato">
          <span class="planta-dato-key">Distribución</span>
          <span class="planta-dato-val">Dos plantas productivas<br/>+ depósito</span>
        </div>
        <div class="planta-dato">
          <span class="planta-dato-key">Capacidad</span>
          <span class="planta-dato-val">Duplicada desde 2022</span>
        </div>
        <div class="planta-dato">
          <span class="planta-dato-key">Zona</span>
          <span class="planta-dato-val">Sector industrial habilitado</span>
        </div>
        <div class="planta-dato">
          <span class="planta-dato-key">Stock</span>
          <span class="planta-dato-val">Materias primas, semielaborados<br/>y producto terminado</span>
        </div>
      </div>
    </div>
    <div class="seccion-texto">
      <p class="seccion-label">Nuestra planta</p>
      <h2>Fabricación propia, control total del proceso</h2>
      <p>
        Durante años operamos desde San Martín, Gran Buenos Aires. En 2022 tomamos la decisión estratégica de relocalizar la planta a La Tablada, donde adquirimos un predio de mayor superficie distribuida en dos pisos, en una zona industrial de uso exclusivo.
      </p>
      <p>
        El traslado nos permitió duplicar nuestra capacidad productiva y disponer de un espacio adecuado para el almacenamiento tanto de materias primas como de productos semielaborados y terminados. El resultado es una operación más eficiente, con tiempos de respuesta más cortos y mayor disponibilidad de stock para nuestros clientes y aplicadores en todo el país.
      </p>
      <p>
        Fabricar en Argentina, con materias primas seleccionadas y control de calidad propio en cada etapa del proceso, es una decisión que no negociamos: es lo que nos permite garantizar la consistencia de cada sistema que sale de nuestra planta.
      </p>
    </div>
  </div>
</div>

<!-- VALORES -->
<div class="seccion">
  <p class="seccion-label">Cómo trabajamos</p>
  <h2>Los principios que guían cada proyecto</h2>
  <div class="valores-grid">
    <div class="valor-card">
      <div class="valor-icono">⬡</div>
      <p class="valor-titulo">Desarrollo a medida</p>
      <p class="valor-texto">Cada industria tiene condiciones de uso distintas. No vendemos productos genéricos: formulamos el sistema más adecuado para cada proceso, carga y sustrato.</p>
    </div>
    <div class="valor-card">
      <div class="valor-icono">⬡</div>
      <p class="valor-titulo">Asistencia técnica directa</p>
      <p class="valor-texto">Nuestro equipo técnico acompaña cada proyecto desde la visita inicial hasta la puesta en servicio, garantizando una aplicación correcta y un resultado duradero.</p>
    </div>
    <div class="valor-card">
      <div class="valor-icono">⬡</div>
      <p class="valor-titulo">Red de aplicadores certificados</p>
      <p class="valor-texto">Formamos y certificamos aplicadores en todo el territorio nacional, asegurando que cada instalación cumpla con los estándares técnicos de POXDRIVE.</p>
    </div>
    <div class="valor-card">
      <div class="valor-icono">⬡</div>
      <p class="valor-titulo">Presencia nacional</p>
      <p class="valor-texto">Operamos en casi todas las provincias de la República Argentina, con servicio de mano de obra propia y a través de nuestra red de aplicadores asociados.</p>
    </div>
  </div>
</div>

<!-- CTA -->
<div class="cta-banda">
  <div class="cta-inner">
    <div class="cta-texto">
      <h3>¿Tenés un proyecto industrial en mente?</h3>
      <p>Consultanos sin cargo. Analizamos tu caso y te recomendamos el sistema más adecuado.</p>
    </div>
    <a href="/contacto" class="cta-btn">Solicitar asesoramiento</a>
  </div>
</div>

<!-- FOOTER -->
<footer>
  <div class="footer-inner">
    <div class="footer-logo">POX<span>DRIVE</span></div>
    <p class="footer-copy">FARBENTEC S.R.L. · Rincón 4672, La Tablada, Bs. As. · consultas@poxdrive.com.ar</p>
  </div>
</footer>

<script>
(function(){
  var btn=document.getElementById('dd-btn'),menu=document.getElementById('dd-menu');
  if(!btn||!menu) return;
  btn.addEventListener('click',function(e){e.stopPropagation();menu.classList.toggle('open');});
  menu.addEventListener('click',function(e){e.stopPropagation();});
  document.addEventListener('click',function(){menu.classList.remove('open');});
})();
</script>
</body>
</html>
