<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Pisos para Industria Farmacéutica — POXDRIVE</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Calibri, Arial, sans-serif; background: #1A1A1A; color: #F0EDEA; }
    header { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(26,26,26,0.97); border-bottom: 1px solid #2a2a2a; }
    .nav-inner { max-width: 1100px; margin: 0 auto; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
    .nav-logo { font-size: 1.4rem; font-weight: 900; letter-spacing: 2px; text-decoration: none; color: #F0EDEA; }
    .nav-logo span { color: #E8500A; }
    nav { display: flex; gap: 2rem; align-items: center; }
    nav a { color: #F0EDEA; text-decoration: none; font-size: 0.9rem; opacity: 0.75; transition: opacity 0.2s; }
    nav a:hover, nav a.active { opacity: 1; color: #E8500A; }
    .nav-cta { background: #E8500A; color: #fff !important; padding: 0.5rem 1.2rem; font-weight: 700; border-radius: 2px; opacity: 1 !important; }

    /* HERO */
    .hero { padding: 9rem 2rem 5rem; max-width: 1100px; margin: 0 auto; }
    .breadcrumb { font-size: 0.8rem; opacity: 0.5; margin-bottom: 1.5rem; }
    .breadcrumb span { color: #E8500A; }
    .hero-eyebrow { font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; color: #E8500A; margin-bottom: 1rem; }
    .hero h1 { font-size: 2.8rem; line-height: 1.2; font-style: italic; font-family: Georgia, serif; max-width: 700px; margin-bottom: 1.5rem; }
    .hero-sub { font-size: 1.05rem; opacity: 0.7; max-width: 600px; line-height: 1.7; margin-bottom: 2.5rem; }
    .hero-badges { display: flex; gap: 1rem; flex-wrap: wrap; }
    .badge { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15); padding: 0.5rem 1.1rem; font-size: 0.8rem; border-radius: 2px; }

    /* SECCIÓN GENÉRICA */
    section { padding: 5rem 2rem; }
    .container { max-width: 1100px; margin: 0 auto; }
    .section-label { font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; color: #E8500A; margin-bottom: 0.8rem; }
    .section-title { font-size: 2rem; font-style: italic; font-family: Georgia, serif; margin-bottom: 0.8rem; }
    .section-sub { opacity: 0.6; font-size: 0.95rem; max-width: 580px; line-height: 1.6; margin-bottom: 2.5rem; }

    /* REQUISITOS */
    .req-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; }
    .req-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 1.8rem; }
    .req-card .icon { font-size: 1.8rem; margin-bottom: 1rem; }
    .req-card h4 { font-size: 1rem; font-weight: 700; margin-bottom: 0.6rem; }
    .req-card p { font-size: 0.88rem; opacity: 0.65; line-height: 1.6; }

    /* SOLUCIÓN */
    .sol-wrap { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden; }
    .sol-header { background: #E8500A; padding: 2rem 2.5rem; }
    .sol-header h3 { font-size: 1.6rem; font-style: italic; font-family: Georgia, serif; margin-bottom: 0.4rem; }
    .sol-header p { opacity: 0.9; font-size: 0.9rem; }
    .sol-body { padding: 2.5rem; }
    .ficha { width: 100%; border-collapse: collapse; }
    .ficha tr { border-bottom: 1px solid rgba(255,255,255,0.08); }
    .ficha td { padding: 0.8rem 0; font-size: 0.9rem; }
    .ficha td:first-child { opacity: 0.55; width: 45%; }
    .ficha td:last-child { font-weight: 600; }

    /* SISTEMAS */
    .sistemas-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.2rem; margin-top: 1rem; }
    .sistema-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 1.5rem; }
    .sistema-card .num { font-size: 1.6rem; font-style: italic; font-family: Georgia, serif; color: #E8500A; margin-bottom: 0.5rem; }
    .sistema-card h4 { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.4rem; }
    .sistema-card .zona { font-size: 0.8rem; opacity: 0.55; margin-bottom: 0.6rem; }
    .sistema-card p { font-size: 0.85rem; opacity: 0.7; line-height: 1.5; }

    /* CASO */
    .caso-wrap { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden; }
    .caso-header { padding: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .caso-header .tag { font-size: 0.7rem; letter-spacing: 2px; text-transform: uppercase; color: #E8500A; margin-bottom: 0.8rem; }
    .caso-header h3 { font-size: 1.5rem; font-style: italic; font-family: Georgia, serif; }
    .caso-stats { display: grid; grid-template-columns: repeat(4, 1fr); padding: 2rem 2.5rem; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .caso-stat b { display: block; font-size: 1.8rem; font-style: italic; font-family: Georgia, serif; color: #E8500A; }
    .caso-stat span { font-size: 0.8rem; opacity: 0.55; }
    .caso-body { padding: 2.5rem; }
    .caso-body p { opacity: 0.7; line-height: 1.7; margin-bottom: 1.5rem; font-size: 0.95rem; }
    .sistema-steps { display: flex; flex-direction: column; gap: 0.6rem; }
    .step { display: flex; gap: 1rem; align-items: flex-start; }
    .step .n { background: #E8500A; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; margin-top: 2px; }
    .step p { font-size: 0.88rem; opacity: 0.75; line-height: 1.5; margin: 0; }

    /* CTA */
    .cta-section { background: #E8500A; }
    .cta-section .container { text-align: center; }
    .cta-section h2 { font-size: 2rem; font-style: italic; font-family: Georgia, serif; margin-bottom: 0.8rem; }
    .cta-section p { opacity: 0.9; margin-bottom: 2rem; }
    .cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .btn-white { background: #fff; color: #E8500A; padding: 0.8rem 1.8rem; font-weight: 700; border-radius: 2px; text-decoration: none; font-size: 0.9rem; }
    .btn-outline { border: 2px solid rgba(255,255,255,0.6); color: #fff; padding: 0.8rem 1.8rem; border-radius: 2px; text-decoration: none; font-size: 0.9rem; }

    /* FOOTER */
    footer { background: #111; border-top: 1px solid #222; padding: 3rem 2rem; }
    .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 2rem; font-size: 0.85rem; opacity: 0.6; }

    @media (max-width: 768px) {
      .hero h1 { font-size: 2rem; }
      .caso-stats { grid-template-columns: repeat(2, 1fr); }
      nav { display: none; }
    }

    /* RECURSOS */
    .recursos-section { border-top: 1px solid rgba(255,255,255,0.06); }
    .recursos-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 2rem; }
    .recurso-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 1.4rem 1.5rem; text-decoration: none; color: #F0EDEA; display: block; transition: border-color 0.2s, background 0.2s; }
    .recurso-card:hover { border-color: #E8500A; background: rgba(232,80,10,0.07); }
    .recurso-tipo { font-size: 0.68rem; letter-spacing: 2px; text-transform: uppercase; color: #E8500A; margin-bottom: 0.5rem; }
    .recurso-nombre { font-size: 0.92rem; font-weight: 700; line-height: 1.3; margin-bottom: 0.3rem; }
    .recurso-meta { font-size: 0.78rem; opacity: 0.45; }
  </style>
</head>
