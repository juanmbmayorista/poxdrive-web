  <!-- JSON-LD VideoObject: Terraza histórica Rosario -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "Restauración de terraza histórica en Rosario con sistema epoxi",
    "description": "Recuperación de terraza en edificio histórico en Rosario. Sistema epoxi sobre superficie deteriorada con exigencias estéticas y de durabilidad.",
