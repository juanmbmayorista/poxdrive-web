  <!-- JSON-LD VideoObject: Cochera OXIDRIVE -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "Cochera con sistema OXIDRIVE: acabado industrial en uso residencial",
    "description": "Aplicación del sistema OXIDRIVE en cochera residencial. Acabado tipo industrial con alta resistencia a tráfico vehicular y manchas de aceite.",
    "thumbnailUrl": "https://i.ytimg.com/vi/wQoiIBdVTAw/hqdefault.jpg",
    "uploadDate": "2026-06-05",
    "contentUrl": "https://www.youtube.com/watch?v=wQoiIBdVTAw",
    "embedUrl": "https://www.youtube-nocookie.com/embed/wQoiIBdVTAw"
  }
  </script>
  <!-- Google tag (GA4) + eventos de conversión -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0GN6S6NJN9"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-0GN6S6NJN9');
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href]');
      if (!a) return;
      var h = a.getAttribute('href') || '';
      if (h.indexOf('wa.me') > -1) gtag('event', 'whatsapp_click', { link_url: h, page_path: location.pathname });
      else if (h.indexOf('tel:') === 0) gtag('event', 'telefono_click', { page_path: location.pathname });
      else if (h.indexOf('mailto:') === 0) gtag('event', 'email_click', { page_path: location.pathname });
      else if (/\.pdf($|\?)/i.test(h)) gtag('event', 'descarga_ficha', { file_name: h.split('/').pop(), page_path: location.pathname });
    });
  </script>
</head>
<body>
<nav>
